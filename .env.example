# The only value you must set. Copy it from your Sokko seller dashboard:
# Settings > Developers. That page shows your real id.
NEXT_PUBLIC_SOKKO_STOREFRONT_ID=

# Leave the rest unset unless Sokko has pointed you at another deployment
# (staging, or a self-hosted install). Defaults are Sokko production.
# NEXT_PUBLIC_SOKKO_API_URL=https://sokko.ke/api
# NEXT_PUBLIC_SOKKO_CHECKOUT_URL=https://sokko.ke/checkout
# NEXT_PUBLIC_SOKKO_TENANT_ID=tenant_core

# Your own public URL. Used for canonical links and share cards.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
